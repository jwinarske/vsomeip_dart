# Dart
.dart_tool/
pubspec.lock

# Build artifacts
example/flutter_vehicle_app/.desktop-homescreen
build*/
coverage/
*.so
*.dylib

# IDE
.idea/
*.iml
.vscode/

# Don't ignore lib/ — it contains Dart source
!lib/

# Don't let build*/ / *.so / *.dylib rules match inside vendored submodules.
# Pub-archive exclusion of third_party/ is handled by .pubignore.
!third_party/
!third_party/**
