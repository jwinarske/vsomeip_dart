# Files excluded from `dart pub publish`. The publisher uses `.gitignore`
# rules by default; this file overrides them with publish-specific exclusions
# so build artifacts and example scaffolding don't leak into the archive.

# CMake / Ninja build trees produced by hooks/build.dart and developer builds
build/
build-*/
**/cmake-build-*/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/compile_commands.json
**/*.o
**/*.a
*.so
*.dylib

# Local artifacts from dart doc / dart test --coverage
.dart_tool/
doc/api/
coverage/
*.lcov

# Flutter example scaffolding (regenerated by `flutter create` per platform).
# Drop the entire per-platform tree — pub consumers don't need it, and these
# files are noisy + regenerated by `flutter create` against the user's SDK.
example/*/build/
example/*/.dart_tool/
example/*/.flutter-plugins
example/*/.flutter-plugins-dependencies
example/*/linux/
example/*/macos/
example/*/windows/
example/*/android/
example/*/ios/
example/*/web/
example/*/test/

# Submodules — vsomeip + capnpc-dart are huge and only needed for source
# builds via the hook. Pub consumers don't ship vendored upstream code.
third_party/

# Pre-generated Cap'n Proto C++ headers — capnpc regenerates them on build.
generated/

# Workspace-private CI workflows live in the parent monorepo
# (.github/workflows/vsomeip-dart.yml). The package-local copy is
# reference-only and not needed in the published archive.
.github/

# Internal planning doc — not part of the published API surface.
VSOMEIP_DART_PLAN.md

# IDE / editor noise
.idea/
.vscode/
*.iml
.DS_Store
